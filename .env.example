NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# The Sanity Studio is embedded in the app at /studio (http://localhost:3000/studio) and reads the NEXT_PUBLIC_ values above.
# Add your site origins (http://localhost:3000 and your production domain) under sanity.io/manage → API → CORS origins
# with "Allow credentials" ticked, otherwise the Studio cannot log in.

# Supabase: URL looks like https://xxxx.supabase.co (NOT the sb_publishable key)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 8+ characters, long and random. Admin stays locked if shorter.
ADMIN_PASSWORD=

# Optional
NEXT_PUBLIC_SITE_URL=https://your-domain.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
